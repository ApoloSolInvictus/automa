{
  "name": "automa-business",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/copy-demo.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-automa \"node --test tests/firestore.rules.mjs\""
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "firebase-admin": "13.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "vite": "^8.2.2"
  }
}
