{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/telegram.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/{firebase-admin,@google-cloud,google-auth-library,google-gax,jwks-rsa,jsonwebtoken,fast-deep-equal,@fastify}/**"
    },
    "api/business.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/{firebase-admin,@google-cloud,google-auth-library,google-gax,jwks-rsa,jsonwebtoken,fast-deep-equal,@fastify}/**"
    }
  },
  "rewrites": [{ "source": "/dashboard", "destination": "/index.html" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
  ] }]
}
