VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional server-side alias used to validate chat sessions through Firebase Auth REST.
FIREBASE_WEB_API_KEY=
# Server only. Never prefix these with VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional alternative: full Firebase service-account JSON (server-only).
FIREBASE_SERVICE_ACCOUNT_JSON=
# OpenAI server-only variables: set the real values in Vercel Project Settings.
# Never put the real API key in this file or in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Telegram server-only variables. Configure real values in Vercel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_UID=
TELEGRAM_AGENT_ID=support-bot-v2-1
TELEGRAM_WEBHOOK_URL=https://automa.wstudio3d.com/api/telegram
# Gmail OAuth server-only variables. Create a Google OAuth Web client and set this exact redirect URI.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_STATE_SECRET=
GMAIL_REDIRECT_URI=https://automa.wstudio3d.com/api/gmail
# Optional. Firebase Auth UID authorized to reset every profile. If empty, TELEGRAM_OWNER_UID is used.
AUTOMA_DATA_RESET_OWNER_UID=
